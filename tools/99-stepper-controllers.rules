# Fixed device names for the two stepper-controller Arduinos on one Raspberry Pi.
# Canonical rule file lives at udev/99-stepper-controllers.rules (or generate
# automatically with `sudo bash tools/setup_udev.sh`).
#
#   MOTOR 1  ->  /dev/stepper_a
#   MOTOR 2  ->  /dev/stepper_b

SUBSYSTEM=="tty", KERNELS=="1-1.2", SYMLINK+="stepper_a", MODE="0666"
SUBSYSTEM=="tty", KERNELS=="1-1.3", SYMLINK+="stepper_b", MODE="0666"
