#!/usr/bin/env python3
"""Fake `openocd` for tests/check_scripts.sh.

Emulates just enough of the STM32H743 + ST-LINK behaviour that
tools/stlink_flash.sh depends on, so the flash wrapper can be exercised
without a board:

  * a tiny Tcl-ish interpreter: `;`/newline separated statements, `catch {}`,
    `if {$_rc != 0} { ... } else { ... }`, `echo`, `sleep`
  * RAM model for `mww` / `mdw` and the flash-loader work area
  * halt model for `halt` / `reset halt` reported back through DHCSR
  * flash stages (`flash erase_address`, `flash write_image`, `verify_image`)

Environment:
  STUB_RAM_FAULT     comma separated RAM bases; each such 64 KiB window faults
                     on read/write, like DTCM on the real fixture
  STUB_RAM_FAULT_ABOVE  address; inside that 64 KiB window everything at or
                     above it faults, i.e. a work area that answers isolated
                     writes at its base and fails the loader footprint
                     ("Failed to write memory at 0x24001874")
  STUB_SWD_FAIL=1    emulate "unable to connect to the target"
  STUB_HALT_FAIL=1   `halt` and `reset halt` never stick (DHCSR stays running)
  STUB_ERASE_FAIL=1  `flash erase_address` times out (watchdog reset)
  STUB_DROP_AFTER    `halt`|`erase`|`write`: target drops off SWD afterwards
                     ("Fail reading CTRL/STAT register"), permanently
  STUB_DROP_ON_RAM=1 the link dies on the first RAM write (work-area probe)
  STUB_AP_FAIL=1     core debug registers (0xE0001000-0xE00FFFFF, except
                     DHCSR) refuse reads/writes, like a dying AP
  STUB_BLANK_VECTORS=1  sector 0 is erased: 0x08000000/0x08000004 read back
                     0xFFFFFFFF, like a board left mid-flash
  STUB_FLASH_SIZE_KB device flash size reported by `flash probe 0` (default
                     2048); the stm32h7x driver splits it over two banks
  STUB_WRITE_FAIL_ONCE=1  the *first* `flash write_image` of the whole run
                     fails with "Failed to write memory at 0x<wa>4074", the
                     later ones work - the real "loader RAM unreachable" log
  STUB_WRITE_STATE_FILE  where that one-shot flag lives
  STUB_SPEED_MAX     connect only succeeds at adapter speeds <= this kHz
                     (emulates a marginal link that needs a slow clock)
  STUB_LINK_PATTERN  per-session link health, e.g. "101" = every second
                     session fails at init (counter kept in STUB_STATE_FILE)
  STUB_STATE_FILE    where that session counter lives (default /tmp file)
  STUB_OPENOCD_LOG   append each simulated session to this file
"""

import os
import re
import sys

args = sys.argv[1:]
commands: list[str] = []
i = 0
while i < len(args):
    if args[i] == "-c" and i + 1 < len(args):
        commands.append(args[i + 1])
        i += 2
    elif args[i] == "-f" and i + 1 < len(args):
        commands.append('echo "cfg %s"' % args[i + 1])
        i += 2
    else:
        i += 1

script = "\n".join(commands)

log_path = os.environ.get("STUB_OPENOCD_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as fh:
        fh.write("---- openocd\n" + script + "\n")

fault_bases = [
    int(p, 0) for p in (os.environ.get("STUB_RAM_FAULT") or "").split(",") if p.strip()
]

BANNER = [
    "Info : STLINK V2J46S7 (API v2) VID:PID 0483:3748",
    "Info : Target voltage: 3.280000",
    "Info : SWD DPIDR 0x6ba02477",
    "Info : [stm32h7x.cpu0] Examination succeed",
]

state = {
    "banner": False,
    "speed": 1000,
    "halted": False,
    "work_area": 0x20000000,   # OpenOCD default for stm32h7x.cfg
    "dropped": False,
    # Initial SP/PC of a programmed board. A board left mid-flash has sector 0
    # erased, so both read back 0xFFFFFFFF (pc 0xfffffffe / msp 0xfffffffc).
    "mem": (
        {0x08000000: 0xFFFFFFFF, 0x08000004: 0xFFFFFFFF}
        if os.environ.get("STUB_BLANK_VECTORS") == "1"
        else {0x08000000: 0x24080000, 0x08000004: 0x08000201}
    ),
    "rc": 0,
    "err": "",
    "erase_done": False,
    "write_done": False,
    "stalled": False,
}


def emit(line: str, stream=sys.stdout) -> None:
    stream.write(line + "\n")
    stream.flush()


def fail(line: str) -> None:
    emit(line, sys.stderr)
    raise SystemExit(1)


fault_above = int(os.environ.get("STUB_RAM_FAULT_ABOVE") or "0", 0)


def broken(addr: int) -> bool:
    if fault_above and fault_above <= addr < fault_above + 0x10000:
        return True
    return any(base <= addr < base + 0x10000 for base in fault_bases)


RAM_WINDOWS = (
    (0x20000000, 0x20020000),
    (0x24000000, 0x24080000),
    (0x30000000, 0x30048000),
    (0x38000000, 0x38010000),
)


def ap_fault(addr: int) -> bool:
    """Core debug registers stop answering when STUB_AP_FAIL=1."""
    if os.environ.get("STUB_AP_FAIL") != "1":
        return False
    if addr == 0xE000EDF0:  # DHCSR stays readable: tests want a specific mode
        return False
    return 0xE0001000 <= addr < 0xE00FFFFF


def show_banner() -> None:
    if state["banner"]:
        return
    for line in BANNER:
        emit(line)
    state["banner"] = True
    if os.environ.get("STUB_AP_FAIL") == "1":
        # FPB/DWT writes are how OpenOCD finishes examining the target.
        emit("Error: Failed to write memory at 0xe0002004", sys.stderr)
        emit(
            "Error: [stm32h7x.cpu0] Execution of event examine-end failed:",
            sys.stderr,
        )


def drop_if_requested(after: str) -> None:
    if (os.environ.get("STUB_DROP_AFTER") or "").strip().lower() == after:
        state["dropped"] = True
        emit("Error: Fail reading CTRL/STAT register. Force reconnect", sys.stderr)


def split_statements(line: str) -> list[str]:
    """Split on `;` at brace depth 0."""
    out, buf, depth = [], "", 0
    for ch in line:
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
        if ch == ";" and depth == 0:
            out.append(buf)
            buf = ""
        else:
            buf += ch
    out.append(buf)
    return [s.strip() for s in out if s.strip()]


def do_halt() -> None:
    if os.environ.get("STUB_AP_FAIL") == "1":
        emit("Error: Failed to write memory at 0xe0002010", sys.stderr)
        raise SystemExit(1)
    if os.environ.get("STUB_HALT_FAIL") == "1":
        # erratum-style: halt does not stick, the core keeps running
        emit(
            "Warn : [stm32h7x.cpu0] target was in unknown state when halt was requested",
            sys.stderr,
        )
        raise SystemExit(1)
    state["halted"] = True
    emit("Info : [stm32h7x.cpu0] halt accepted")
    drop_if_requested("halt")


def do_reset_halt() -> None:
    if os.environ.get("STUB_AP_FAIL") == "1":
        emit("Error: Failed to write memory at 0xe0002010", sys.stderr)
        emit("Error: [stm32h7x.cpu0] target not halted", sys.stderr)
        raise SystemExit(1)
    if os.environ.get("STUB_HALT_FAIL") == "1":
        emit(
            "Warn : [stm32h7x.cpu0] target was in unknown state when halt was requested",
            sys.stderr,
        )
        emit("Error: [stm32h7x.cpu0] target not halted", sys.stderr)
        raise SystemExit(1)
    state["halted"] = True
    emit("Info : [stm32h7x.cpu0] reset halt via SYSRESETREQ + vector catch")
    drop_if_requested("halt")


def write_fails_once() -> bool:
    """True the first time it is asked, False afterwards (per run)."""
    if os.environ.get("STUB_WRITE_FAIL_ONCE") != "1":
        return False
    path = (
        os.environ.get("STUB_WRITE_STATE_FILE")
        or (os.environ.get("STUB_STATE_FILE") or "/tmp/stub_openocd_sessions") + ".write"
    )
    try:
        with open(path, encoding="utf-8") as fh:
            seen = int(fh.read().strip() or "0")
    except (OSError, ValueError):
        seen = 0
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(str(seen + 1))
    return seen == 0


def do_statement(stmt: str) -> None:
    if stmt.startswith("echo "):
        text = stmt[5:].strip()
        if text.startswith('"') and text.endswith('"'):
            text = text[1:-1]
        text = text.replace("$_e", state["err"] or "halt failed")
        emit(text)
        return

    if stmt.startswith("sleep"):
        return

    if stmt.startswith("set _rc [catch {"):
        inner = stmt[len("set _rc [catch {"):].rstrip("}").rstrip()
        inner = inner.rsplit("}", 1)[0].strip()
        try:
            do_statement(inner)
            state["rc"] = 0
            state["err"] = ""
        except SystemExit:
            state["rc"] = 1
            state["err"] = "halt failed"
        return

    if stmt.startswith("catch {"):
        inner = stmt[len("catch {"):].rsplit("}", 1)[0].strip()
        for part in split_statements(inner):
            try:
                do_statement(part)
            except SystemExit:
                pass
        return

    if re.search(r"\breset halt\b", stmt):
        do_reset_halt()
        return
    if re.search(r"\breset run\b", stmt):
        state["halted"] = False
        return
    if re.search(r"\bhalt\b", stmt):
        do_halt()
        return
    if stmt == "init":
        show_banner()
        return
    if stmt == "exit":
        return
    m = re.search(r"adapter speed (\d+)", stmt)
    if m:
        speed = int(m.group(1))
        state["speed"] = speed
        limit = (os.environ.get("STUB_SPEED_MAX") or "").strip()
        if limit and speed > int(limit, 0):
            emit(f"Info : clock speed {speed} kHz")
            emit("Error: init mode failed (unable to connect to the target)", sys.stderr)
            raise SystemExit(1)
        return

    m = re.search(r"configure -work-area-phys (0x[0-9a-fA-F]+)", stmt)
    if m:
        state["work_area"] = int(m.group(1), 16)
        return

    m = re.search(r"mww (0x[0-9a-fA-F]+) (0x[0-9a-fA-F]+)$", stmt)
    if m:
        addr, value = int(m.group(1), 16), int(m.group(2), 16)
        if ap_fault(addr):
            fail(f"Error: Failed to write memory at 0x{addr:08x}")
        if broken(addr):
            fail(f"Error: Failed to write memory at 0x{addr:08x}")
        state["mem"][addr] = value
        if os.environ.get("STUB_DROP_ON_RAM") == "1" and any(
            lo <= addr < hi for lo, hi in RAM_WINDOWS
        ):
            state["dropped"] = True
            emit("Error: Fail reading CTRL/STAT register. Force reconnect", sys.stderr)
        return

    m = re.search(r"mdw (0x[0-9a-fA-F]+)$", stmt)
    if m:
        addr = int(m.group(1), 16)
        if ap_fault(addr):
            fail(f"Error: Failed to read memory at 0x{addr:08x}")
        if state["dropped"]:
            fail("Error: Failed to read memory and, additionally, failed to find out where")
        if broken(addr):
            fail(f"Error: Failed to read memory at 0x{addr:08x}")
        if state["mem"].get(addr) is None and addr == 0xE000EDF0:
            # DHCSR: S_HALT (bit 17) reflects whether the core stopped
            value = 0xA05F0013 if state["halted"] else 0x00000003
        else:
            value = state["mem"].get(addr, 0)
        emit(f"0x{addr:08x}: {value:08x}")
        return

    if re.search(r"flash probe 0$", stmt):
        size_kb = int(os.environ.get("STUB_FLASH_SIZE_KB") or "2048", 0)
        emit("Info : Device: STM32H74x/75x")
        emit(f"Info : flash size probed value {size_kb}k")
        emit("Info : STM32H7 flash has dual banks")
        emit(
            f"Info : Bank (0) size is {size_kb // 2} kb, base address is 0x08000000"
        )
        return

    m = re.search(r"flash erase_address (0x[0-9a-fA-F]+) (0x[0-9a-fA-F]+|\d+)$", stmt)
    if m:
        if state["dropped"]:
            fail("Error: Failed to read memory and, additionally, failed to find out where")
        if os.environ.get("STUB_ERASE_FAIL") == "1":
            emit("Error: erase time-out or operation error sector 0", sys.stderr)
            emit("Error: failed erasing sectors 0 to 0", sys.stderr)
            raise SystemExit(1)
        emit(f"erased address {m.group(1)} (length {m.group(2)}) in 0.400000s")
        if state["work_area"] is None:  # pragma: no cover - never happens
            pass
        state["erase_done"] = True
        drop_if_requested("erase")
        return

    m = re.search(r"flash write_image (\S+) (0x[0-9a-fA-F]+)$", stmt)
    if m:
        path = m.group(1)
        if state["dropped"]:
            fail("Error: error waiting for target flash write algorithm")
        if not os.path.isfile(path):
            fail(f"Error: could not open {path}")
        base = state["work_area"]
        for addr in (base, base + 0x2194, base + 0x3994):
            if broken(addr):
                fail(f"Error: Failed to write memory at 0x{addr:08x}")
        if write_fails_once():
            fail(f"Error: Failed to write memory at 0x{base + 0x4074:08x}")
        emit(f"wrote {os.path.getsize(path)} bytes from file {path}")
        state["write_done"] = True
        drop_if_requested("write")
        return

    m = re.search(r"verify_image (\S+) (0x[0-9a-fA-F]+)$", stmt)
    if m:
        path = m.group(1)
        if state["dropped"]:
            fail("Error: Failed to read memory and, additionally, failed to find out where")
        if not os.path.isfile(path):
            fail(f"Error: could not open {path}")
        base = state["work_area"]
        for addr in (base, base + 0x2194, base + 0x3994):
            if broken(addr):
                fail(f"Error: Failed to write memory at 0x{addr:08x}")
        emit(f"verified {os.path.getsize(path)} bytes at {m.group(2)} in 0.002000s")
        return

    # Unknown statement: ignore, like an unused Tcl setup line


pattern = (os.environ.get("STUB_LINK_PATTERN") or "").strip()
pattern_fail = False
if pattern:
    state_file = os.environ.get("STUB_STATE_FILE") or "/tmp/stub_openocd_sessions"
    try:
        with open(state_file, encoding="utf-8") as fh:
            index = int(fh.read().strip() or "0")
    except (OSError, ValueError):
        index = 0
    with open(state_file, "w", encoding="utf-8") as fh:
        fh.write(str(index + 1))
    pattern_fail = pattern[index % len(pattern)] == "1"

if os.environ.get("STUB_SWD_FAIL") == "1" or pattern_fail:
    emit("Info : STLINK V2J46S7 (API v2) VID:PID 0483:3748")
    emit("Info : Target voltage: 3.280000")
    emit("Error: init mode failed (unable to connect to the target)", sys.stderr)
    raise SystemExit(1)

# --- minimal if/else tracking ------------------------------------------------
branch_stack: list[dict] = []


def active() -> bool:
    return all(b["active"] for b in branch_stack)


for raw_line in script.splitlines():
    line = raw_line.strip()
    if not line:
        continue

    if line.startswith("if {") and line.endswith("{"):
        cond_true = "!= 0" not in line or state["rc"] != 0
        branch_stack.append({"active": cond_true, "seen_else": False})
        continue
    if line in ("} else {", "} else {", "else {"):
        if branch_stack:
            top = branch_stack[-1]
            top["active"] = not top["active"] if not top["seen_else"] else top["active"]
            top["seen_else"] = True
        continue
    if line == "}":
        if branch_stack:
            branch_stack.pop()
        continue

    if not active():
        continue

    for stmt in split_statements(line):
        if state["dropped"] and not stmt.startswith("echo"):
            # every later session dies the same way
            emit("Error: Failed to read memory and, additionally, failed to find out where", sys.stderr)
            raise SystemExit(1)
        do_statement(stmt)

if state["dropped"] and not state["write_done"]:
    raise SystemExit(1)

raise SystemExit(0)
