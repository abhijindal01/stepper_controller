#!/usr/bin/env python3
"""Fake `st-info --probe` for tests/check_scripts.sh.

STUB_STINFO_FLASH_KB  flash size reported (default 1024); printed in BYTES like
                      stlink-tools 1.8.0 does (`flash: 1048576` for a 1 MiB part)
STUB_STINFO_UNIT_KIB  1 = print the size in KiB instead (`flash: 1024`)
STUB_STINFO_FAIL      1 = no target found (chipid 0x000), like the real dongle
"""

import os
import sys

flash_kb = int(os.environ.get("STUB_STINFO_FLASH_KB") or "1024", 0)

print("Found 1 stlink programmers")
print("  version:    V2J46S7")
print("  serial:     B55B5A1A00000000D409F301")

if os.environ.get("STUB_STINFO_FAIL") == "1":
    print("  flash:      0 (pagesize: 0)")
    print("  sram:       0")
    print("  chipid:     0x000")
    print("Failed to enter SWD mode", file=sys.stderr)
    raise SystemExit(1)

if os.environ.get("STUB_STINFO_UNIT_KIB") == "1":
    print(f"  flash:      {flash_kb} (pagesize: 131072)")
else:
    print(f"  flash:      {flash_kb * 1024} (pagesize: 131072)")
print("  sram:       131072")
print("  chipid:     0x450")
print("  dev-type:   STM32H74x_H75x")
raise SystemExit(0)
